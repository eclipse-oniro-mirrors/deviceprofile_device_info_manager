# Tests that directly call the service implementation use its non-hidden DSO.
import("//build/test.gni")
import("//foundation/deviceprofile/device_info_manager/deviceprofile.gni")
_dp_service_test_resources =
    "${device_profile_path}/test/resource/device_info_manager/ohos_test.xml"

template("dp_service_unittest") {
  ohos_unittest(target_name) {
    forward_variables_from(invoker, "*")
    if (!defined(resource_config_file)) {
      resource_config_file = _dp_service_test_resources
    }
    if (!defined(configs)) {
      configs = []
    }
    configs +=
        [ "${device_profile_service}/test:dp_service_test_runtime_config" ]
  }
}

template("dp_service_fuzztest") {
  ohos_fuzztest(target_name) {
    forward_variables_from(invoker, "*")
    if (!defined(resource_config_file)) {
      resource_config_file = _dp_service_test_resources
    }
    if (!defined(configs)) {
      configs = []
    }
    configs +=
        [ "${device_profile_service}/test:dp_service_test_runtime_config" ]
  }
}
